<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn),CS1570,CS1572,CS1574,CS1587,CS8765,CS8767,CS8604,CS8618,CS8600,CS8602</NoWarn>
    </PropertyGroup>
    <ItemGroup>
      <ProjectReference Include="..\TheMaths\TheMaths.csproj" />
      <ProjectReference Include="..\veldrid\src\Veldrid\Veldrid.csproj" />
      <ProjectReference Include="..\VmaNative\VmaNative.csproj" />
      <ProjectReference Include="..\TheEngine.SourceGenerator\TheEngine.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DefineConstants>$(DefineConstants);ENGINE_RELEASE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="GUI" />
    </ItemGroup>

    <Import Project="..\lib3d.props" />
    
    <ItemGroup>
      <None Update="internalShaders\theengine.cginc">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="internalShaders\*.frag">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="internalShaders\*.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="internalShaders\*.vert">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="internalShaders\*.hull">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="internalShaders\*.comp">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="icons\*.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="fonts\calibri.fnt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="fonts\calibri.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="fonts\DroidSans.ttf">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="fonts\DroidSans-Bold.ttf">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="fonts\lucide.ttf">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ECS\EntityExtensionsCodeGen.tt">
        <LastGenOutput>EntityExtensionsCodeGen.cs</LastGenOutput>
        <Generator>TextTemplatingFileGenerator</Generator>
      </None>
      <None Update="meshes\sphere.obj">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
        <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
        <PackageReference Include="Hexa.NET.ImGuizmo" Version="2.2.9" />
      <PackageReference Include="JetBrains.Profiler.Api" Version="1.4.2" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="OpenTK.Windowing.Desktop" Version="4.9.4" />
      <PackageReference Include="Silk.NET.Shaderc" Version="2.22.0" />
      <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.22.0" />
      <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
      <PackageReference Include="Silk.NET.Vulkan.Loader.Native" Version="2025.9.12" />
      <PackageReference Include="Silk.NET.MoltenVK.Native" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
      <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.22.0" />
      <PackageReference Include="System.CodeDom" Version="9.0.8" />
      <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
      <PackageReference Include="Tedd.SpanUtils" Version="1.0.8" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="ECS\EntityExtensionsCodeGen.cs">
        <DependentUpon>EntityExtensionsCodeGen.tt</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
