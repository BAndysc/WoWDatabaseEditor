<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:idc="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia">
        <Styles.Resources>
                <SolidColorBrush x:Key="DockBorderSubtleBrush">#FF8E9BBC</SolidColorBrush>
                <SolidColorBrush x:Key="DockDocumentContentBorderBrush">#FF8E9BBC</SolidColorBrush>

                <!-- unify Dock accents with the app accent hue: the stock theme mixes hardcoded
                     VS blue (document tabs) with raw SystemAccentColor (tool headers) -->
                <SolidColorBrush Color="#007ACC" x:Key="DockApplicationAccentBrushLow" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#1C97EA" x:Key="DockApplicationAccentBrushMed" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#52B0EF" x:Key="DockApplicationAccentBrushHigh" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#007ACC" x:Key="DockApplicationAccentBrushIndicator" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <!-- the theme aliases below resolve via StaticResource inside Dock, so they must be re-pointed here too -->
                <SolidColorBrush Color="#007ACC" x:Key="DockTabActiveBackgroundBrush" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#007ACC" x:Key="DockTabActiveIndicatorBrush" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#1C97EA" x:Key="DockTabHoverBackgroundBrush" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#1C97EA" x:Key="DockTabSelectedForegroundBrush" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#52B0EF" x:Key="DockTabCloseHoverBackgroundBrush" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#52B0EF" x:Key="DockChromeButtonDangerHoverBrush" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Color="#007ACC" x:Key="DockTargetIndicatorBrush" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <!-- active tool-window header: same hue-shifted accent as tabs instead of raw SystemAccentColor -->
                <SolidColorBrush Color="#007ACC" x:Key="DockSurfaceHeaderActiveBrush" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Accent.BaseColor="#4D6082" x:Key="ToolChromeControl.Grip" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Accent.BaseColor="#515F7F" x:Key="DocumentControl.PART_TabStripItem" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
                <SolidColorBrush Accent.BaseColor="#5F7096" x:Key="DocumentControl.PART_TabStrip.pointerover.not.selected" Accent.L="0.4,0.6" Accent.Hue="{DynamicResource AccentHue}" />
        </Styles.Resources>
        <Style Selector="idc|ToolChromeControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="idc|ToolChromeControl /template/ Grid#PART_Grip">
                <Setter Property="Background" Value="{StaticResource ToolChromeControl.Grip}"/>
        </Style>
        <Style Selector="idc|ToolChromeControl /template/ TextBlock#PART_Title">
                <Setter Property="Foreground" Value="{DynamicResource DockThemeForegroundBrush}" />
        </Style>
        <Style Selector="idc|DocumentControl /template/ Border#PART_Border DeferredContentControl#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ContentBackground}" />
        </Style>
        <Style Selector="idc|DocumentControl DocumentTabStripItem">
                <Setter Property="Background" Value="{DynamicResource TitleBarBackground}" />
        </Style>
        <Style Selector="idc|DocumentControl DocumentTabStripItem:pointerover:not(:selected)">
                <Setter Property="Background" Value="{StaticResource DocumentControl.PART_TabStrip.pointerover.not.selected}"/>
                <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="idc|DocumentControl:not(:active) DocumentTabStripItem:pointerover">
                <Setter Property="Background" Value="{StaticResource DocumentControl.PART_TabStrip.pointerover.not.selected}"/>
                <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="idc|ToolControl /template/ Border#PART_Border DeferredContentControl#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ContentBackground}" />
        </Style>
        <Style Selector="idc|ToolControl ToolTabStripItem">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource DocumentControl.PART_TabStripItem}" />
        </Style>
        <Style Selector="idc|ToolControl ToolTabStripItem:pointerover">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource DocumentControl.PART_TabStrip.pointerover.not.selected}" />
        </Style>
        <Style Selector="idc|ToolControl ToolTabStripItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource DockApplicationAccentForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource ContentBackground}" />
        </Style>
        <Style Selector="idc|DocumentControl /template/ Border#PART_Border">
                <Setter Property="BorderThickness" Value="1,0,1,1"/>
        </Style>
        <Style Selector="idc|DocumentControl /template/ Grid#PART_Grid">
                <Setter Property="Background" Value="{StaticResource DocumentControl.PART_TabStripItem}"/>
        </Style>
        <Style Selector="idc|DocumentControl:not(:active) DocumentTabStripItem:selected">
                <Setter Property="Background" Value="{StaticResource DocumentControl.PART_TabStripItem}" />
        </Style>
        <Style Selector="DocumentTabStripItem">
                <Setter Property="Foreground" Value="#333333" />
        </Style>
        <Style Selector="ToolTabStrip">
                <Setter Property="Margin" Value="0,-2,0,0" />
        </Style>
</Styles>
