      <ProjectReference Include="..\Libraries\Classic.Avalonia\src\Classic.CommonControls.Avalonia\Classic.CommonControls.Avalonia.csproj" />
      <ProjectReference Include="..\WDE.MVVM\WDE.MVVM.csproj" />
