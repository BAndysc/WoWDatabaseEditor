<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WDE.Common.Avalonia.Controls;assembly=WDE.Common.Avalonia"
             xmlns:views="clr-namespace:WDE.CMangosConditions.Avalonia.Views"
             xmlns:avalonia="clr-namespace:WDE.Common.Avalonia;assembly=WDE.Common.Avalonia"
             xmlns:controls1="clr-namespace:AvaloniaStyles.Controls;assembly=AvaloniaStyles"
             xmlns:viewModels="clr-namespace:WDE.CMangosConditions.ViewModels;assembly=WDE.CMangosConditions"
             xmlns:data="clr-namespace:WDE.CMangosConditions.Data;assembly=WDE.CMangosConditions"
             mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="500"
             Name="Root"
             x:DataType="viewModels:UnitConditionEditorViewModel"
             x:Class="WDE.CMangosConditions.Avalonia.Views.UnitConditionsEditor">
    <UserControl.Styles>
        <StyleInclude Source="avares://WDE.CMangosConditions.Avalonia/Views/LabeledControl.axaml"></StyleInclude>
        <Style Selector="views|LabeledControl">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Styles>
    <UserControl.KeyBindings>
        <KeyBinding Command="{CompiledBinding UndoCommand}" Gesture="{x:Static avalonia:KeyGestures.Undo}" />
        <KeyBinding Command="{CompiledBinding RedoCommand}" Gesture="{x:Static avalonia:KeyGestures.Redo}" />
    </UserControl.KeyBindings>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <views:LabeledControl Header="Id (negative for custom rows)" DataContext="{CompiledBinding Id, Mode=OneWay}">
                <ParameterBox Parameter="{ReflectionBinding GenericParameter}"
                              ParameterValue="{CompiledBinding Value}" />
            </views:LabeledControl>
            <views:LabeledControl Header="Logic" DataContext="{CompiledBinding IsOr, Mode=OneWay}">
                <ParameterBox Parameter="{ReflectionBinding GenericParameter}"
                              ParameterValue="{CompiledBinding Value}" />
            </views:LabeledControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{CompiledBinding Clauses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:UnitConditionClauseViewModel">
                        <Grid Margin="0,0,0,4" ColumnDefinitions="2*,4,130,4,2*,4,Auto">
                            <controls1:CompletionComboBox Grid.Column="0"
                                                          SelectedItem="{CompiledBinding SelectedVariable}"
                                                          Items="{CompiledBinding #Root.((viewModels:UnitConditionEditorViewModel)DataContext).Variables}"
                                                          HorizontalAlignment="Stretch">
                                <controls1:CompletionComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="data:UnitConditionVariableJson">
                                        <TextBlock Text="{CompiledBinding}" />
                                    </DataTemplate>
                                </controls1:CompletionComboBox.ItemTemplate>
                            </controls1:CompletionComboBox>
                            <ParameterBox Grid.Column="2"
                                          DataContext="{CompiledBinding Op, Mode=OneWay}"
                                          Parameter="{ReflectionBinding GenericParameter}"
                                          ParameterValue="{CompiledBinding Value}" />
                            <ParameterBox Grid.Column="4"
                                          DataContext="{CompiledBinding Value, Mode=OneWay}"
                                          Parameter="{ReflectionBinding GenericParameter}"
                                          ParameterValue="{CompiledBinding Value}" />
                            <Button Grid.Column="6"
                                    ToolTip.Tip="Remove this clause"
                                    Command="{CompiledBinding #Root.((viewModels:UnitConditionEditorViewModel)DataContext).RemoveClauseCommand}"
                                    CommandParameter="{CompiledBinding}">✕</Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Command="{CompiledBinding AddClauseCommand}" ToolTip.Tip="A unit condition row holds at most 8 clauses">Add clause</Button>
            <TextBlock VerticalAlignment="Center" Opacity="0.6">(max 8 clauses)</TextBlock>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="6"
                BorderThickness="1" BorderBrush="{DynamicResource TextControlBorderBrush}" CornerRadius="4">
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Text="{CompiledBinding Readable}" />
        </Border>

        <TextBlock Grid.Row="4" Margin="0,4,0,0"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   IsVisible="{CompiledBinding HasErrors}"
                   Text="{CompiledBinding Errors}" />
    </Grid>
</UserControl>
