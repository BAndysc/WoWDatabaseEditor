{
  "id": "gameobject_template_classic",
  "compatibility": [
    "CMaNGOS-Classic"
  ],
  "name": "Gameobject Template",
  "description": "Templates of all gameobjects: doors, chests, buttons, traps, transports and more. The type determines how the object behaves and how the 24 data fields are interpreted; every gameobject spawn references an entry from this table.",
  "table_name": "gameobject_template",
  "table_index_name": "entry",
  "record_mode": "Template",
  "group_name": "Templates",
  "icon_path": "Icons/document_gameobject_template.png",
  "picker": "GameobjectParameter",
  "primary_key": [
    "entry"
  ],
  "groups": [
    {
      "group_name": "General",
      "fields": [
        {
          "name": "Entry",
          "db_column_name": "entry",
          "value_type": "uint"
        },
        {
          "name": "Name",
          "db_column_name": "name",
          "value_type": "string"
        },
        {
          "name": "Type",
          "help": "Gameobject type: determines behaviour and the meaning of the data0-data23 fields.",
          "db_column_name": "type",
          "value_type": "GameobjectTypeParameter"
        }
      ]
    },
    {
      "group_name": "Visual",
      "fields": [
        {
          "name": "Display Id",
          "db_column_name": "displayId",
          "value_type": "GameObjectDisplayInfoParameter"
        },
        {
          "name": "Size",
          "help": "Model scale of the gameobject.",
          "db_column_name": "size",
          "value_type": "float",
          "default": 1.0
        },
        {
          "name": "Icon Name",
          "help": "Cursor icon shown when hovering the object (e.g. taxi, quest, attack).",
          "db_column_name": "IconName",
          "value_type": "GameObjectIconNameParameter"
        }
      ]
    },
    {
      "group_name": "Faction & flags",
      "fields": [
        {
          "name": "Faction",
          "db_column_name": "faction",
          "value_type": "FactionTemplateParameter",
          "zero_is_blank": true
        },
        {
          "name": "Flags",
          "db_column_name": "flags",
          "value_type": "GameObjectFlagParameter",
          "zero_is_blank": true
        },
        {
          "name": "Extra Flags",
          "db_column_name": "ExtraFlags",
          "value_type": "CmangosGameObjectExtraFlagsParameter",
          "zero_is_blank": true
        }
      ]
    },
