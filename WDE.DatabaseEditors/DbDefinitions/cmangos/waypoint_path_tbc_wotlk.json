{
  "compatibility": [
    "CMaNGOS-TBC",
    "CMaNGOS-WoTLK"
  ],
  "name": "Waypoint Path",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "Standalone waypoint paths keyed by a global PathId, assigned to creatures by scripts or spawn group formations. Every path must have a name defined in waypoint_path_name. Orientation 100 means no orientation at the point.",
  "table_name": "waypoint_path",
  "table_index_name": "PathId",
  "record_mode": "MultiRecord",
  "skip_quick_load": true,
  "group_name": "Waypoints",
  "icon_path": "Icons/document_waypoints.png",
  "picker": "TableReference(waypoint_path_name#PathId)Parameter",
  "primary_key": [
    "PathId",
    "Point"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Path Id",
          "db_column_name": "PathId",
          "value_type": "TableReference(waypoint_path_name#PathId)Parameter"
        },
        {
          "name": "Point",
          "db_column_name": "Point",
          "value_type": "uint",
          "preferred_width": 75.0
        },
        {
          "name": "X",
          "db_column_name": "PositionX",
          "value_type": "float",
          "preferred_width": 89.0
        },
        {
          "name": "Y",
          "db_column_name": "PositionY",
          "value_type": "float"
        },
        {
          "name": "Z",
          "db_column_name": "PositionZ",
          "value_type": "float"
        },
        {
          "name": "O",
          "db_column_name": "Orientation",
          "value_type": "float",
          "default": 100
        },
        {
          "name": "Wait Time (ms)",
          "db_column_name": "WaitTime",
          "value_type": "MillisecondsParameter"
        },
        {
          "name": "Script Id",
          "db_column_name": "ScriptId",
          "value_type": "uint",
          "zero_is_blank": true
        },
        {
          "name": "Comment",
          "db_column_name": "Comment",
          "value_type": "string",
          "can_be_null": true
        }
      ]
    }
  ]
}