{
  "id": "faction_store",
  "compatibility": [
//    "CMaNGOS-TBC"
  ],
  "name": "Faction Store",
  "description": "Database copy of Faction.dbc used by the TBC core instead of the client file: base reputation per race/class, reputation flags, spillover parameters and localized faction names. Loaded as sFactionStore SQL storage.",
  "table_name": "faction_store",
  "table_index_name": "Entry",
  "record_mode": "SingleRow",
  "group_name": "Advanced",
  "icon_path": "Icons/document_faction_change.png",
  "picker": "FactionParameter",
  "primary_key": [
    "Entry"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Entry",
          "db_column_name": "Entry",
          "value_type": "uint",
          "help": "Faction id (Faction.dbc)."
        },
        {
          "name": "Reputation List Id",
          "db_column_name": "ReputationListID",
          "value_type": "int",
          "help": "Index in the client reputation pane, -1 if the faction has no reputation."
        },
        {
          "name": "Base Rep Race Mask 1",
          "db_column_name": "BaseRepRaceMask1",
          "value_type": "RaceMaskParameter",
          "zero_is_blank": true
        },
        {
