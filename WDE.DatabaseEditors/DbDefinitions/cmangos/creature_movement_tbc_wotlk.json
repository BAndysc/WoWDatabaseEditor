{
  "compatibility": [
    "CMaNGOS-TBC",
    "CMaNGOS-WoTLK"
  ],
  "name": "Creature Movement",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "Waypoint path for a single creature spawn, keyed by the creature's guid. Used by the waypoint movement generator when the spawn has MovementType 2 (WAYPOINT_MOTION_TYPE) or 4 (LINEAR_WP_MOTION_TYPE) in the `creature` table.",
  "table_name": "creature_movement",
  "table_index_name": "Id",
  "record_mode": "MultiRecord",
  "skip_quick_load": true,
  "group_name": "Waypoints",
  "icon_path": "Icons/document_waypoints.png",
  "picker": "CreatureGUIDParameter",
  "primary_key": [
    "Id",
    "Point"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Creature Guid",
          "db_column_name": "Id",
          "value_type": "CreatureGUIDParameter"
        },
        {
          "name": "Point Id",
          "db_column_name": "Point",
          "value_type": "uint"
        },
        {
          "name": "X",
          "db_column_name": "PositionX",
          "value_type": "float"
        },
        {
          "name": "Y",
          "db_column_name": "PositionY",
          "value_type": "float"
        },
        {
          "name": "Z",
          "db_column_name": "PositionZ",
          "value_type": "float"
        },
        {
          "name": "O",
          "db_column_name": "Orientation",
          "value_type": "float",
          "default": 100
        },
        {
          "name": "Wait Time (ms)",
          "db_column_name": "WaitTime",
          "value_type": "MillisecondsParameter"
        },
        {
          "name": "Script Id",
          "db_column_name": "ScriptId",
          "value_type": "uint",
          "zero_is_blank": true
        },
        {
          "name": "Comment",
          "db_column_name": "Comment",
          "value_type": "string",
          "can_be_null": true,
          "preferred_width": 666.0
        }
      ]
    }
  ]
}