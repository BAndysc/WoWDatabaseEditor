{
  "compatibility": [
    "CMaNGOS-TBC",
    "CMaNGOS-WoTLK"
  ],
  "name": "Creature Movement Template",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "Waypoint paths shared by all spawns of a creature entry (multiple paths per entry via PathId 0-255). Used by the waypoint movement generator when the creature template has MovementType 2 (WAYPOINT_MOTION_TYPE) or 4 (LINEAR_WP_MOTION_TYPE).",
  "table_name": "creature_movement_template",
  "table_index_name": "Entry",
  "record_mode": "MultiRecord",
  "skip_quick_load": true,
  "group_name": "Waypoints",
  "icon_path": "Icons/document_waypoints.png",
  "picker": "CreatureParameter",
  "primary_key": [
    "Entry",
    "PathId",
    "Point"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Entry",
          "db_column_name": "Entry",
          "value_type": "CreatureParameter"
        },
        {
          "name": "Path Id",
          "db_column_name": "PathId",
          "value_type": "uint"
        },
        {
          "name": "Point Id",
          "db_column_name": "Point",
          "value_type": "uint"
        },
        {
          "name": "X",
          "db_column_name": "PositionX",
          "value_type": "float"
        },
        {
          "name": "Y",
          "db_column_name": "PositionY",
          "value_type": "float"
        },
        {
          "name": "Z",
          "db_column_name": "PositionZ",
          "value_type": "float"
        },
        {
          "name": "O",
          "db_column_name": "Orientation",
          "value_type": "float",
          "default": 100
        },
        {
          "name": "Wait Time (ms)",
          "db_column_name": "WaitTime",
          "value_type": "MillisecondsParameter"
        },
        {
          "name": "Script Id",
          "db_column_name": "ScriptId",
          "value_type": "uint",
          "zero_is_blank": true
        },
        {
          "name": "Comment",
          "db_column_name": "Comment",
          "value_type": "string",
          "can_be_null": true,
          "preferred_width": 485.0
        }
      ]
    }
  ]
}