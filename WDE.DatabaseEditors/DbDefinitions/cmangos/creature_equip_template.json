    "CMaNGOS-WoTLK"
  ],
  "name": "Creature Equipment Template",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "Equipment sets (main hand, off hand, ranged item) displayed by creatures. Referenced from creature_template.EquipmentTemplateId and creature.equipment_id; items must be equipable in a hand.",
  "table_name": "creature_equip_template",
  "table_index_name": "entry",
  "record_mode": "SingleRow",
  "skip_quick_load": true,
  "group_name": "Creatures",
  "icon_path": "Icons/document_creature_template.png",
  "picker": "Parameter",
  "primary_key": [
    "entry"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Equipment Id",
          "help": "Equipment template id, referenced by creature_template.EquipmentTemplateId.",
          "db_column_name": "entry",
          "value_type": "uint"
        },
        {
          "name": "Main Hand Item",
          "db_column_name": "equipentry1",
          "value_type": "ItemParameter",
          "zero_is_blank": true,
          "preferred_width": 295.0
        },
        {
          "name": "Off Hand Item",
          "db_column_name": "equipentry2",
          "value_type": "ItemParameter",
          "zero_is_blank": true,
          "preferred_width": 295.0
        },
        {
          "name": "Ranged Item",
          "db_column_name": "equipentry3",
          "value_type": "ItemParameter",
          "zero_is_blank": true,
          "preferred_width": 295.0
        }
      ]
    }
  ]
}