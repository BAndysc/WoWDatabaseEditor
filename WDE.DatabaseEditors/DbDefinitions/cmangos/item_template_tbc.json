{
  "id": "item_template_tbc",
  "compatibility": [
    "CMaNGOS-TBC"
  ],
  "name": "Item Template",
  "description": "Definition of every item in the game: class, stats, damage, requirements, on-use/equip spells, sockets, vendor prices and loot money. Loaded once at server startup by ObjectMgr::LoadItemPrototypes; there is no reload command, changes require a server restart.",
  "table_name": "item_template",
  "table_index_name": "entry",
  "record_mode": "Template",
  "group_name": "Items",
  "icon_path": "Icons/document_table.png",
  "picker": "ItemParameter",
  "primary_key": [
    "entry"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Entry",
          "db_column_name": "entry",
          "value_type": "uint"
        },
        {
          "name": "Class",
          "db_column_name": "class",
          "value_type": "ItemClassParameter"
        },
        {
          "name": "Subclass",
          "db_column_name": "subclass",
          "value_type": "uint",
          "help": "Subclass within the item class, class-dependent (e.g. Weapon: 0 = one-hand axe, 1 = two-hand axe, 2 = bow, 15 = dagger...; Armor: 0 = misc, 1 = cloth, 2 = leather, 3 = mail, 4 = plate, 6 = shield). See ItemSubclass* enums in ItemPrototype.h."
        },
        {
          "name": "Sound Override Subclass",
          "db_column_name": "unk0",
          "value_type": "int",
          "default": -1,
          "help": "Sent to the client instead of the real subclass for sound purposes; -1 = none (use the real subclass)."
        },
        {
          "name": "Name",
          "db_column_name": "name",
          "value_type": "string"
        },
        {
          "name": "Display Id",
          "db_column_name": "displayid",
          "value_type": "uint",
          "help": "ItemDisplayInfo.dbc id."
        },
        {
          "name": "Quality",
          "db_column_name": "Quality",
          "value_type": "ItemQualityParameter"
        }
      ]
    },
    {
      "group_name": "General",
      "fields": [
        {
          "name": "Flags",
          "db_column_name": "Flags",
          "value_type": "ItemFlagParameter"
        },
        {
          "name": "Bonding",
          "db_column_name": "bonding",
          "value_type": "ItemBondingParameter"
        },
        {
          "name": "Description",
          "db_column_name": "description",
          "value_type": "string",
          "help": "Flavour text shown in the tooltip."
        },
        {
          "name": "Inventory Type",
          "db_column_name": "InventoryType",
          "value_type": "ItemInventoryTypeParameter"
        },
        {
          "name": "Material",
          "db_column_name": "Material",
          "value_type": "ItemMaterialParameter",
          "help": "Affects the sounds the item makes when moved in the inventory."
        },
        {
          "name": "Sheath",
          "db_column_name": "sheath",
          "value_type": "ItemSheathParameter",
          "zero_is_blank": true,
          "help": "Where the weapon is shown on the character when sheathed."
        },
        {
          "name": "Buy Count",
          "db_column_name": "BuyCount",
          "value_type": "uint",
          "default": 1,
          "help": "Stack size a vendor sells at once."
        },
        {
          "name": "Buy Price",
          "db_column_name": "BuyPrice",
          "value_type": "MoneyParameter"
        },
        {
          "name": "Sell Price",
          "db_column_name": "SellPrice",
          "value_type": "MoneyParameter"
        },
        {
          "name": "Max Count",
          "db_column_name": "maxcount",
          "value_type": "uint",
          "help": "Maximum number of the item a player can carry; 0 = no limit."
        },
        {
          "name": "Stackable",
          "db_column_name": "stackable",
          "value_type": "uint",
          "default": 1,
          "help": "Maximum stack size."
        },
        {
          "name": "Container Slots",
          "db_column_name": "ContainerSlots",
          "value_type": "uint",
          "help": "Number of slots for bags/quivers."
        },
        {
          "name": "Bag Family",
          "db_column_name": "BagFamily",
          "value_type": "ItemBagFamilyParameter",
          "help": "Bag family the item can be stored in (special bags)."
        },
        {
          "name": "Duration",
          "db_column_name": "Duration",
          "value_type": "uint",
          "help": "Item lifetime in seconds, 0 = permanent. By default only in-game time counts; see Extra Flags for real-time counting."
        },
        {
          "name": "Extra Flags",
          "db_column_name": "ExtraFlags",
          "value_type": "CmangosItemExtraFlagsParameter"
        }
      ]
    },
    {
