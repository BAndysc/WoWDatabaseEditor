  "name": "Npc Text",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "Texts displayed in the NPC gossip window, referenced by gossip_menu.text_id and npc_gossip.textid. Each entry holds up to 8 text alternatives picked by probability; every alternative has male and female text variants, a language and up to three timed emotes.",
  "table_name": "npc_text",
  "table_index_name": "ID",
  "record_mode": "SingleRow",
  "group_name": "Texts",
  "icon_path": "Icons/document_npc_text.png",
  "reload_command": "reload npc_text",
  "picker": "NpcTextParameter",
  "primary_key": [
    "ID"
  ],
