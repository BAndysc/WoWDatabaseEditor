{
  "compatibility": [
    "CMaNGOS-Classic",
    "CMaNGOS-TBC",
    "CMaNGOS-WoTLK"
  ],
  "name": "Gameobject Spawn Entry",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "Possible gameobject entries for a spawn with entry 0: on each (re)spawn the server picks one of the listed entries at random for that guid.",
  "table_name": "gameobject_spawn_entry",
  "table_index_name": "guid",
  "record_mode": "SingleRow",
  "skip_quick_load": true,
  "group_name": "Spawns",
  "icon_path": "Icons/document_dice.png",
  "picker": "GameobjectGUIDParameter",
  "primary_key": [
    "guid",
    "entry"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Guid",
          "help": "gameobject.guid of the spawn (which must have entry 0).",
          "db_column_name": "guid",
          "value_type": "GameobjectGUIDParameter"
        },
        {
          "name": "Spawn",
          "help": "Open the gameobject spawn.",
          "meta": "table:gameobject;`guid` = {guid}"
        },
        {
          "name": "Entry",
          "help": "One of the gameobject entries that can be randomly chosen for this spawn.",
          "db_column_name": "entry",
          "value_type": "GameobjectParameter"
        },
        {
          "name": "Gameobject",
          "help": "Open the gameobject template.",
          "meta": "tableByKey:gameobject_template;entry"
        }
      ]
    }
  ]
}