{
  "compatibility": [
    "CMaNGOS-WoTLK",
    "CMaNGOS-TBC",
    "CMaNGOS-Classic"
  ],
  "name": "Mangos String",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "Localized text strings used by server-side systems (scripts, EventAI, announcements, error messages) referenced by a numeric entry.",
  "table_name": "mangos_string",
  "table_index_name": "entry",
  "record_mode": "SingleRow",
  "skip_quick_load": true,
  "group_name": "Advanced",
  "icon_path": "Icons/document_trinity_strings.png",
  "reload_command": "reload mangos_string",
  "primary_key": [
    "entry"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Entry",
          "help": "Referenced from C++ code and scripts (e.g. LANG_* constants) as well as custom script/DB usage. Negative built-in ranges are reserved; positive entries are free for scripts/modules.",
          "db_column_name": "entry",
          "value_type": "uint",
          "read_only": true
        },
        {
          "name": "Content Default",
          "help": "enUS/enGB text (LOCALE_enUS).",
          "db_column_name": "content_default",
          "value_type": "string"
        },
        {
