{
  "compatibility": [
    "CMaNGOS-WoTLK"
  ],
  "name": "Gameobject",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "The table contains all gameobject spawns",
  "table_name": "gameobject",
  "table_index_name": "guid",
  "record_mode": "SingleRow",
  "group_name": "Spawns",
  "icon_path": "Icons/document_gameobjects.png",
  "primary_key": [
    "guid"
  ],
  "foreign_tables": [
    {
      "table_name": "gameobject_addon",
      "foreign_key": [
        "guid"
      ]
    }
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Guid",
          "db_column_name": "guid",
          "value_type": "uint",
          "read_only": true
        },
        {
          "name": "Entry",
          "db_column_name": "id",
          "value_type": "GameobjectParameter"
        },
        {
          "name": "Template",
          "help": "Open the gameobject template of this spawn.",
          "meta": "tableByKey:gameobject_template;id"
        },
        {
          "name": "Map",
          "db_column_name": "map",
          "value_type": "MapParameter"
        },
        {
          "name": "Spawn Mask",
          "db_column_name": "spawnMask",
          "value_type": "SpawnMaskParameter",
          "default": 1
        },
        {
          "name": "Phase Mask",
          "db_column_name": "phaseMask",
          "value_type": "PhaseMaskParameter",
          "default": 1
        },
        {
          "name": "Min spawn time secs",
          "db_column_name": "spawntimesecsmin",
          "value_type": "int"
        },
        {
          "name": "Max spawn time secs",
          "db_column_name": "spawntimesecsmax",
          "value_type": "int"
        }
      ]
    },
    {
      "group_name": "Addon",
      "fields": [
        {
          "name": "Anim progress",
          "db_column_name": "animprogress",
          "foreign_table": "gameobject_addon",
          "value_type": "uint",
          "default": 255
        },
        {
          "name": "State",
          "help": "GOState override for this spawn. -1 = no override (falls back to the gameobject spawn's default state).",
          "db_column_name": "state",
          "foreign_table": "gameobject_addon",
          "value_type": "GameobjectStateOrMinus1Parameter",
          "default": -1
        },
        {
          "name": "Path Rotation 0",
          "help": "Quaternion X. Used mainly for transports/paths; the (x,y,z,w) quaternion must be a unit quaternion or it is reset to identity by the loader.",
          "db_column_name": "path_rotation0",
          "foreign_table": "gameobject_addon",
          "value_type": "float"
        },
        {
          "name": "Path Rotation 1",
          "db_column_name": "path_rotation1",
          "foreign_table": "gameobject_addon",
          "value_type": "float"
        },
        {
          "name": "Path Rotation 2",
          "db_column_name": "path_rotation2",
          "foreign_table": "gameobject_addon",
          "value_type": "float"
        },
        {
          "name": "Path Rotation 3",
          "help": "Quaternion W (default 1.0 = identity rotation).",
          "db_column_name": "path_rotation3",
          "foreign_table": "gameobject_addon",
          "value_type": "float",
          "default": 1
        },
        {
          "name": "String Id",
          "help": "Optional string id (must exist as registered via dbscripts SET_STRING_ID / ScriptMgr string ids) used to target this gameobject from db-scripts by name instead of guid.",
          "db_column_name": "StringId",
          "foreign_table": "gameobject_addon",
          "value_type": "uint"
        }
      ]
    },
    {
      "group_name": "Position",
      "fields": [
        {
          "name": "X",
          "db_column_name": "position_x",
          "value_type": "float"
        },
        {
          "name": "Y",
          "db_column_name": "position_y",
          "value_type": "float"
        },
        {
          "name": "Z",
          "db_column_name": "position_z",
          "value_type": "float"
        },
        {
          "name": "Orientation",
          "db_column_name": "orientation",
          "value_type": "float"
        },
        {
          "name": "Rotation 0",
          "db_column_name": "rotation0",
          "value_type": "float"
        },
        {
          "name": "Rotation 1",
          "db_column_name": "rotation1",
          "value_type": "float"
        },
        {
          "name": "Rotation 2",
          "db_column_name": "rotation2",
          "value_type": "float"
        },
        {
          "name": "Rotation 3",
          "db_column_name": "rotation3",
          "value_type": "float"
        }
      ]
    },
    {
      "group_name": "Related tables",
      "fields": [
        {
          "name": "Entry Variants",
          "help": "Random entry choices for this spawn.",
          "meta": "table:gameobject_spawn_entry;`guid` = {guid}"
        },
        {
          "name": "Game Event",
          "help": "Game event spawning/despawning this object.",
          "meta": "table:game_event_gameobject;`guid` = {guid}"
        }
      ]
    }
  ]
}