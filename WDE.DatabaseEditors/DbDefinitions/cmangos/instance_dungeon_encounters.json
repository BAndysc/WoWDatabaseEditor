          "db_column_name": "EncounterName13",
          "value_type": "string",
          "can_be_null": true
        },
        {
          "name": "Encounter Name 14",
          "help": "Encounter name in locale 14.",
          "db_column_name": "EncounterName14",
          "value_type": "string",
          "can_be_null": true
        },
        {
          "name": "Encounter Name 15",
          "help": "Encounter name in locale 15.",
