          "db_column_name": "EncounterName16",
          "value_type": "string",
          "can_be_null": true
        },
        {
          "name": "Name Lang Flags",
          "help": "DBC name language flags (m_name_lang_flags).",
          "db_column_name": "NameLangFlags",
          "value_type": "uint"
        },
        {
          "name": "Spell Icon ID",
          "help": "SpellIcon.dbc id shown for the encounter.",
          "db_column_name": "SpellIconID",
          "value_type": "uint"
        }
      ]
    }
  ]
}