{
  "id": "creature_template_classic",
  "compatibility": [
    "CMaNGOS-Classic"
  ],
  "name": "Creature Template",
  "description": "Main creature definition table: names, models, level and stat multipliers, flags, loot, trainer/vendor links, movement and AI for every creature entry. Loaded once at server startup by ObjectMgr::LoadCreatureTemplates.",
  "table_name": "creature_template",
  "table_index_name": "Entry",
  "record_mode": "Template",
  "group_name": "Templates",
  "icon_path": "Icons/document_creature_template.png",
  "picker": "CreatureParameter",
  "primary_key": [
    "Entry"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Entry",
          "db_column_name": "Entry",
          "value_type": "uint"
        },
        {
          "name": "Name",
          "db_column_name": "Name",
          "value_type": "string"
        },
        {
          "name": "Sub Name",
          "db_column_name": "SubName",
          "value_type": "string",
          "can_be_null": true
        },
        {
          "name": "Min Level",
          "db_column_name": "MinLevel",
          "value_type": "uint",
          "default": 1
        },
        {
          "name": "Max Level",
          "db_column_name": "MaxLevel",
          "value_type": "uint",
          "default": 1
        }
      ]
    },
