{
  "compatibility": [
    "CMaNGOS-WoTLK"
  ],
  "name": "Gameobject Template",
  "single_solution_name": "Gameobject {name} template",
  "multi_solution_name": "Multiple gameobject templates",
  "description": "Templates of all gameobjects: doors, chests, buttons, traps, transports and more. The type determines how the object behaves and how the 24 data fields are interpreted; every gameobject spawn references an entry from this table.",
  "table_name": "gameobject_template",
  "table_index_name": "entry",
  "record_mode": "Template",
  "group_name": "Templates",
  "icon_path": "Icons/document_gameobject_template.png",
  "picker": "GameobjectParameter",
  "table_name_source_field": "name",
  "primary_key": [
    "entry"
  ],
  "foreign_tables": [
    {
      "table_name": "gameobject_template_addon",
      "foreign_key": [
        "Entry"
      ]
    }
  ],
  "groups": [
    {
