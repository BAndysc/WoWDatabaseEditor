{
  "compatibility": [
    "CMaNGOS-Classic",
    "CMaNGOS-TBC",
    "CMaNGOS-WoTLK"
  ],
  "name": "Creature Template Spells",
  "single_solution_name": "",
  "multi_solution_name": "",
  "description": "Sets of up to 10 spells per creature entry, loaded as disabled creature spell lists (Id = entry*100 + setId). Used for the action bars of charmed/possessed creatures and by scripts.",
  "table_name": "creature_template_spells",
  "table_index_name": "entry",
  "record_mode": "SingleRow",
  "skip_quick_load": true,
  "group_name": "Templates",
  "icon_path": "Icons/document_creature_spell.png",
  "picker": "CreatureParameter",
  "primary_key": [
    "entry",
    "setId"
  ],
  "groups": [
    {
      "group_name": "group",
      "fields": [
        {
          "name": "Entry",
          "db_column_name": "entry",
          "value_type": "CreatureParameter"
        },
        {
          "name": "Set Id",
          "help": "Spell set id; the set is registered as creature spell list Id = entry*100 + setId.",
          "db_column_name": "setId",
          "value_type": "uint"
        },
        {
          "name": "Spell 1",
          "db_column_name": "spell1",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 2",
          "db_column_name": "spell2",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 3",
          "db_column_name": "spell3",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 4",
          "db_column_name": "spell4",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 5",
          "db_column_name": "spell5",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 6",
          "db_column_name": "spell6",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 7",
          "db_column_name": "spell7",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 8",
          "db_column_name": "spell8",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 9",
          "db_column_name": "spell9",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        },
        {
          "name": "Spell 10",
          "db_column_name": "spell10",
          "value_type": "SpellParameter",
          "zero_is_blank": true
        }
      ]
    }
  ]
}